MODE=ai
TELEGRAM_MODE=polling
PORT=3000
BASE_URL=

# Data files
DATA_FILE=./data/mappings.json
KNOWLEDGE_BASE_FILE=./data/knowledge-base.json
KNOWLEDGE_DOCS_DIR=./data/docs
GAP_LOG_FILE=./data/gap-log.jsonl

# Telegram — user-facing bot
TELEGRAM_BOT_TOKEN=123456:your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-random-secret
TELEGRAM_POLLING_TIMEOUT_SECONDS=30

# Telegram — agent/ops bot (separate bot for agent notifications)
AGENT_BOT_TOKEN=123456:your-agent-bot-token
AGENT_CHAT_IDS=your-agent-chat-id,-your-group-chat-id

# AWS Bedrock (Claude AI)
# Use permanent IAM credentials — NOT temporary STS tokens
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_SESSION_TOKEN=  <-- leave blank for permanent IAM keys

# AI model
AI_MODEL=global.anthropic.claude-sonnet-4-6
AI_SYSTEM_PROMPT=

# Conversation memory
HISTORY_MAX_TURNS=10
HISTORY_INACTIVITY_MINUTES=30

# Handoff keywords (comma-separated)
HANDOFF_KEYWORDS=人工,转人工,人工客服,投诉,退款,合作,紧急,human,agent

# Handoff / fallback messages
HUMAN_HANDOFF_TEXT=Your request has been passed to a human agent. We'll follow up as soon as possible.
FALLBACK_TEXT=I don't have enough information to answer that. Try rephrasing, or I can connect you with a human agent.

# Webot markets API
WEBOT_MARKETS_URL=https://www.webot.com/apis/papi/v1/spot_markets_us/?client_id=webot.us_web_20260325&tz_name=Asia/Shanghai&tz_offset=28800&sys_lang=zh-CN&app_lang=en-US

# FAQ auto-update scheduler (hour in 24h format, server local time)
FAQ_UPDATE_HOUR=9

# Intercom (optional — leave blank if not using)
INTERCOM_ACCESS_TOKEN=
INTERCOM_API_BASE_URL=https://api.intercom.io
INTERCOM_API_VERSION=2.14
INTERCOM_WEBHOOK_SECRET=

# Superset (optional — leave blank if not using)
SUPERSET_BASE_URL=
SUPERSET_USERNAME=
SUPERSET_PASSWORD=
SUPERSET_DATABASE_ID=1
